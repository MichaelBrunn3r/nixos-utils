---
source: pkgs/djson/src/parser/mod.rs
expression: cases
---
key value pairs
input: `a: 1
        b: 2
        "key with spaces": 3`
ast: [a: 1, b: 2, "key with spaces": 3]

expression statements
input: `1 + 2 * 3`
ast: [Expr(Add(1, Mul(2, 3)))]

string expression
input: `"hello"`
ast: [Expr("hello")]

math expressions
input: `sum: 1 + 2
        difference: 5 - 2
        product: 2 * 3
        quotient: 8 / 2
        precedence: 1 + 2 * 3
        power: 2 ^ 3 ^ 4
        positive: +1
        negative: -2 ^ 2`
ast: [
    sum: Add(1, 2),
    difference: Sub(5, 2),
    product: Mul(2, 3),
    quotient: Div(8, 2),
    precedence: Add(1, Mul(2, 3)),
    power: Exp(2, Exp(3, 4)),
    positive: Positive(1),
    negative: Negative(Exp(2, 2))
]

function calls
input: `inline: foo(1, 2,3)
        multiline: bar(
           1
           2,
           3
        )`
ast: [inline: Call(foo, [1, 2, 3]), multiline: Call(bar, [1, 2, 3])]

expression continuation after let binding
input: `let x = 1
        x + 1`
ast: [let x = 1, Expr(Add(x, 1))]

conditional expression
input: `if (true) { 1 } else { 2 }`
ast: [Expr(If(true, 1, 2))]

member call expression
input: `x.foo()`
ast: [Expr(Call(Access(x, foo), []))]

import expressions
input: `let std = import("std")
        std.math.sin(0)`
ast: [
    let std = Call(import, ["std"]),
    Expr(Call(Access(Access(std, math), sin), [0]))
]

keywords as top-level key
input: `let: 1
        if: 2
        else: 3`
ast: [let: 1, if: 2, else: 3]

keywords as map key
input: `{
            let: 1
            if: 2
            else: 3
        }`
ast: [Expr({let: 1, if: 2, else: 3})]

quoted expression-shaped top-level key
input: `"not_a_string()": 2`
ast: ["not_a_string()": 2]

let binding with map
input: `let value = { nested: 7 }`
ast: [let value = {nested: 7}]

let binding followed by a document field
input: `let value = 7
        result: value`
ast: [let value = 7, result: value]
