---
source: pkgs/djson/src/parser/mod.rs
expression: cases
---
key value pairs
input: `a: 1
        b: 2
        "key with spaces": 3`
ast: [a: 1, b: 2, "key with spaces": 3]

expression continuation after let binding
input: `let x = 1
        x + 1`
ast: [let x = 1, Expr(Add(x, 1))]

import expressions
input: `let std = import("std")
        std.math.sin(0)`
ast: [
    let std = Call(import, ["std"]),
    Expr(Call(Access(Access(std, math), sin), [0]))
]

keywords as top-level key
input: `let: 1
        if: 2
        else: 3`
ast: [let: 1, if: 2, else: 3]

keywords as map key
input: `{
            let: 1
            if: 2
            else: 3
        }`
ast: [Expr({let: 1, if: 2, else: 3})]

quoted expression-shaped top-level key
input: `"not_a_string()": 2`
ast: ["not_a_string()": 2]

let binding with map
input: `let value = { nested: 7 }`
ast: [let value = {nested: 7}]

let binding followed by a document field
input: `let value = 7
        result: value`
ast: [let value = 7, result: value]
