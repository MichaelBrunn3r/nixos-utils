{
	"string": "Hello, JSON!",
	"escaped-string": "line one\nline two\t\"quoted\"\\backslash",
	"integer": 42,
	"negative-integer": -7,
	"fraction": 3.14159,
	"null": null,
	"alias-none": none,
	"alias-nil": nil,
	"boolean-true": true,
	"boolean-false": false,
	"empty-array": [],
	"empty-object": {},
	"array": [
		"string",
		0,
		-1.5,
		true,
		false,
		[],
		{}
	],
	"object": {
		"nested-string": "value",
		"nested-number": 100,
		"nested-array": [1, 2, 3],
		"nested-object": {
			"key": "value"
		}
	}
}
