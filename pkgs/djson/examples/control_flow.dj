#!/usr/bin/env djson

let { assert } = import("std.assert")

if_else: assert([
	if 1 + 1 == 2 	{ 2 } else { 1 } 	== 2
	if 1 + 1 == 1 	{ 2 } else { 1 } 	== 1
	if (1 + 2 == 3) { 3 } else { 1 } 	== 3	// `()` are optional
	if false { assert(false) } else { true }	// then branch is lazy evaluated
	if true { true } else { assert(false) }		// else branch is lazy evaluated
	
	if true {
		if false {
			"then_then"
		} else {
			"then_else"
		}
	} else { "else" } == "then_else"			// Nested
].all())
