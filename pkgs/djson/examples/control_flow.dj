#!/usr/bin/env djson

if_else: [
	if 1 + 1 == 2 	{ 2 } else { 1 } 	== 2
	if 1 + 1 == 1 	{ 2 } else { 1 } 	== 1
	if (1 + 2 == 3) { 3 } else { 1 } 	== 3	// `()` are optional

	
	if true {
		if false {
			"then_then"
		} else {
			"then_else"
		}
	} else {
		"else"
	}									== "then_else"	// Nested
].all()

// keywords as top-level keys
if: 1
else: 2

// Only the selected branch is evaluated.
// lazy: if (enabled) { "safe branch" } else { missing }

