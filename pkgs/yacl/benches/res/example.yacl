// A complete YACL document showcasing literals, imports, expressions, and calls.

let std = import("std")

// Basic values describe the kind of data they contain.
application_name: "YACL feature showcase"
application_enabled: true
application_is_development: false
maximum_retry_count: 5
negative_temperature: -12
pi_approximation: 3.14159

// Identifiers can refer to values supplied by an imported module.
standard_pi_constant: std.math.PI
qualified_constant_reference: std.math.PI

// Arithmetic examples describe their resulting value.
sum_of_two_and_three: 2 + 3
difference_between_ten_and_four: 5 - 2
product_of_six_and_seven: 2 * 3
quotient_of_twenty_and_five: 8 / 2
power_of_two_result: 2 ^ 8
negative_integer_result: -8 + 4
positive_decimal_result: +1.5 + 2.5
precedence_uses_power_before_product: 2 * 3 ^ 2
left_associative_arithmetic_result: 18 - 6 / 3 + 2 * 4

// Trigonometric calls use the imported pi constant.
sine_of_zero_radians: std.math.sin(0)
cosine_of_pi_radians: std.math.cos(std.math.PI)
tangent_of_zero_radians: std.math.tan(0)
arcsine_of_zero: std.math.asin(0)
arccosine_of_one: std.math.acos(1)
arctangent_of_zero: std.math.atan(0)
angle_of_positive_y_axis: std.math.atan2(1, 0)

// Numeric calls demonstrate rounding, bounds, logarithms, and extrema.
absolute_value_of_negative_integer: std.math.abs(-42)
smallest_of_two_numbers: std.math.min(12, 7)
largest_of_two_numbers: std.math.max(12, 7)
clamped_value_between_zero_and_ten: std.math.clamp(42, 0, 10)
square_root_of_nine: std.math.sqrt(9)
natural_logarithm_of_one: std.math.ln(1)
base_two_logarithm_of_256: std.math.log(256, 2)
base_two_logarithm_short_form: std.math.log2(256)
base_ten_logarithm_of_1000: std.math.log10(1000)
floor_of_positive_decimal: std.math.floor(3.75)
ceiling_of_positive_decimal: std.math.ceil(3.25)
nearest_integer_to_positive_decimal: std.math.round(3.5)

// Predicates describe the property of the value they inspect.
finite_number_is_finite: std.math.is_finite(42)
ordinary_number_is_not_infinite: std.math.is_infinite(42)
ordinary_number_is_not_nan: std.math.is_nan(42)

// Longer call expressions give the pretty-printer nested structure to render.
bounded_distance_from_origin: std.math.clamp(
	std.math.sqrt(3 ^ 2 + 4 ^ 2),
	0,
	10,
)
rounded_scaled_measurement: std.math.round(
	std.math.sin(std.math.PI / 2) * 100 / 3,
)
descriptive_nested_calculation: std.math.max(
	std.math.abs(-15),
	std.math.min(
		std.math.ceil(4.2),
		std.math.floor(9.8),
	),
)
