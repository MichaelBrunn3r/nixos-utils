// A small YACL configuration demonstrating literals and builtins.

name = "example"
enabled = true
workers = 2 + 2

// Constants and arithmetic.
tau = 2 * pi
hypotenuse = sqrt(3 ^ 2 + 4 ^ 2)

// Rounding and bounds.
rounded_down = floor(3.75)
rounded_up = ceil(3.25)
clamped_workers = clamp(16, 1, 8)

// Logarithms use the value, base form: log(value, base).
base_two_digits = log(256, 2)
decimal_order = log(100, 10)
natural_log = ln(1)

// Trigonometry uses radians.
right_angle = atan2(1, 0)
quarter_sine = sin(pi / 2)

// Numeric predicates return booleans.
input_is_finite = is_finite(42)
input_is_nan = is_nan(42)
